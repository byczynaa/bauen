# Nginx Configuration Template for Bauen E-Commerce Platform
# =============================================================
# 
# Purpose: Reverse proxy for Node.js backend with HTTPS/TLS
# Location: /etc/nginx/sites-available/bauen-watches
# 
# Setup Steps:
#   1. Replace [YOUR_DOMAIN] with your actual domain
#   2. Replace [EMAIL] with your email for Let's Encrypt
#   3. Copy to /etc/nginx/sites-available/bauen-watches
#   4. Enable: sudo ln -s /etc/nginx/sites-available/bauen-watches /etc/nginx/sites-enabled/
#   5. Test: sudo nginx -t
#   6. Reload: sudo systemctl reload nginx
#   7. Certbot: sudo certbot --nginx -d [YOUR_DOMAIN]

# ============================================
# STEP 1: HTTP to HTTPS Redirect
# ============================================
# Redirect all HTTP traffic to HTTPS

server {
  listen 80;
  listen [::]:80;
  server_name [YOUR_DOMAIN] www.[YOUR_DOMAIN];

  # Allow certbot ACME challenge
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  # Redirect all other traffic to HTTPS
  location / {
    return 301 https://$server_name$request_uri;
  }
}

# ============================================
# STEP 2: HTTPS Configuration
# ============================================
# Main HTTPS server block

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name [YOUR_DOMAIN] www.[YOUR_DOMAIN];

  # ============================================
  # SSL/TLS Configuration
  # ============================================
  # Paths are set by certbot (Let's Encrypt)
  # After running: sudo certbot --nginx -d [YOUR_DOMAIN]

  ssl_certificate /etc/letsencrypt/live/[YOUR_DOMAIN]/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/[YOUR_DOMAIN]/privkey.pem;

  # Modern SSL/TLS settings (A+ rating)
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_stapling on;
  ssl_stapling_verify on;
  ssl_session_tickets off;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

  # Compression
  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
  gzip_min_length 256;
  gzip_vary on;

  # ============================================
  # Frontend Asset Serving
  # ============================================
  # Static files with caching

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
    root /var/www/bauen-watches/dist;
    expires 1y;
    add_header Cache-Control "public, immutable";
    access_log off;
  }

  # ============================================
  # Backend API Proxy
  # ============================================
  # Forward API requests to Node.js server on port 4242

  location /api/ {
    proxy_pass http://localhost:4242;
    
    # Proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    # Connection settings
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Buffering
    proxy_buffering off;
    proxy_request_buffering off;

    # Websocket support (if needed for Supabase realtime)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  # ============================================
  # Stripe Webhook Endpoint
  # ============================================
  # Special handling for webhook to ensure IP is captured correctly

  location /api/stripe/webhook {
    proxy_pass http://localhost:4242;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # ============================================
  # Single Page Application (React Router)
  # ============================================
  # All non-api/static requests go to index.html

  location / {
    root /var/www/bauen-watches/dist;
    
    # Try file, then directory, then index.html for SPA routing
    try_files $uri $uri/ /index.html;
    
    # Cache-busting for index.html
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
  }

  # ============================================
  # Health Check Endpoint
  # ============================================
  # For monitoring and load balancers

  location /api/health {
    proxy_pass http://localhost:4242;
    access_log off;
  }

  # ============================================
  # Security: Block common attack patterns
  # ============================================

  # Block access to common vulnerability paths
  location ~ /\.well-known {
    allow all;
  }

  location ~ /\. {
    deny all;
    access_log off;
    log_not_found off;
  }

  location ~ ~$ {
    deny all;
    access_log off;
    log_not_found off;
  }

  # ============================================
  # Logging
  # ============================================

  access_log /var/log/nginx/bauen-watches-access.log combined;
  error_log /var/log/nginx/bauen-watches-error.log warn;
}

# ============================================
# INSTALLATION & DEPLOYMENT INSTRUCTIONS
# ============================================
#
# 1. INSTALL NGINX & CERTBOT
#    ---------------------
#    Ubuntu/Debian:
#      sudo apt-get update
#      sudo apt-get install -y nginx certbot python3-certbot-nginx
#
#    Verify installation:
#      sudo nginx -v
#      certbot --version
#
# 2. CONFIGURE THIS FILE
#    -------------------
#    sudo nano /etc/nginx/sites-available/bauen-watches
#    
#    Replace these placeholders:
#      [YOUR_DOMAIN] → your actual domain (e.g., bauen-eyewear.com)
#      [EMAIL] → your email for Let's Encrypt notifications
#
# 3. ENABLE SITE
#    -----------
#    sudo ln -s /etc/nginx/sites-available/bauen-watches /etc/nginx/sites-enabled/
#    sudo rm /etc/nginx/sites-enabled/default  # Remove default site
#
# 4. TEST CONFIGURATION
#    -------------------
#    sudo nginx -t
#    Output should be: "syntax is ok" and "test is successful"
#
# 5. OBTAIN SSL CERTIFICATE
#    -----------------------
#    sudo certbot --nginx -d bauen-eyewear.com
#    
#    Follow prompts:
#      - Enter your email
#      - Agree to terms
#      - Choose to redirect HTTP to HTTPS
#
#    Certbot will automatically:
#      - Obtain certificate from Let's Encrypt
#      - Update nginx config with certificate paths
#      - Enable auto-renewal (runs daily)
#
# 6. START/RELOAD NGINX
#    ------------------
#    sudo systemctl start nginx
#    sudo systemctl enable nginx  # Auto-start on reboot
#    sudo systemctl reload nginx  # Apply config changes
#
# 7. VERIFY SETUP
#    ------------
#    Test HTTPS:
#      curl https://bauen-eyewear.com/api/health
#
#    Check certificate:
#      sudo certbot certificates
#
#    View nginx status:
#      sudo systemctl status nginx
#
# 8. MONITOR LOGS
#    -----------
#    Watch access logs:
#      tail -f /var/log/nginx/bauen-watches-access.log
#
#    Check for errors:
#      tail -f /var/log/nginx/bauen-watches-error.log
#
#    Monitor Node.js backend:
#      ps aux | grep "node.*4242"
#
# ============================================
# CERTIFICATE AUTO-RENEWAL
# ============================================
#
# Let's Encrypt certificates expire after 90 days.
# Certbot automatically renews certificates via a daily cron job.
#
# Check renewal status:
#   sudo certbot renew --dry-run
#
# View renewal logs:
#   sudo journalctl -u certbot.service --no-pager
#
# ============================================
# TROUBLESHOOTING
# ============================================
#
# Issue: "Connection refused" (502 Bad Gateway)
# → Check Node.js backend is running: ps aux | grep node
# → Check port 4242 is listening: sudo netstat -tlnp | grep 4242
#
# Issue: "Certificate not found"
# → Run certbot again: sudo certbot --nginx -d bauen-eyewear.com
#
# Issue: "Permission denied" accessing backend
# → Check nginx user permissions: sudo -u www-data curl localhost:4242/api/health
#
# Issue: HTTP/2 not working
# → Verify OpenSSL version: openssl version
# → Update: sudo apt-get upgrade openssl
#
# Full restart (if needed):
#   sudo systemctl restart nginx
#   # Wait for certificate renewal to trigger automatically
#
