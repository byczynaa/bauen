# Stripe keys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend runtime config
VITE_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key
VITE_API_URL=http://localhost:4242

# Server-side admin auth (do not prefix with VITE_)
INVENTORY_ADMIN_PASSWORD=change-this-admin-passcode
# Optional bcrypt hash alternative to plain password above
# INVENTORY_ADMIN_PASSWORD_HASH=$2a$10$exampleexampleexampleexampleexampleexample
SESSION_SECRET=replace-this-with-a-long-random-secret

# Supabase inventory persistence and reservation backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Apply supabase/schema.sql in the Supabase SQL editor before starting the API

# CORS origin allowed by backend
FRONTEND_URL=http://localhost:5173
# Optional explicit allowlist (comma-separated). Defaults to FRONTEND_URL.
# CORS_ORIGINS=https://www.bauen-eyewear.com,https://bauen-eyewear.com

# Runtime mode
NODE_ENV=development
