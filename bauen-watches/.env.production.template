# Production Environment Configuration Template
# ============================================
# Copy this file to .env and fill in all values marked with [REQUIRED]
# Never commit actual .env file to version control

# Node Environment (DO NOT CHANGE)
NODE_ENV=production

# ============================================
# Server & Domain Configuration
# ============================================
FRONTEND_URL=https://[YOUR_DOMAIN].com
CORS_ORIGINS=https://[YOUR_DOMAIN].com

# Optional: Add multiple origins if needed (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# STRIPE LIVE KEYS [REQUIRED]
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
# DO NOT use test keys (sk_test_*, pk_test_*)

# Secret key for backend payment processing
STRIPE_SECRET_KEY=sk_live_[REQUIRED - Get from Stripe Dashboard]

# Publishable key for frontend
VITE_STRIPE_PUBLIC_KEY=pk_live_[REQUIRED - Get from Stripe Dashboard]

# Webhook signing secret
# Get from: https://dashboard.stripe.com/webhooks
# Create endpoint for: https://[YOUR_DOMAIN].com/api/stripe/webhook
# Select events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
STRIPE_WEBHOOK_SECRET=whsec_[REQUIRED - Get from Stripe Webhooks]

# ============================================
# SUPABASE CONFIGURATION [REQUIRED]
# ============================================
# Get from: https://app.supabase.com/project/[PROJECT]/settings/api

# Database URL
SUPABASE_URL=https://[YOUR_PROJECT].supabase.co

# Service Role Key (NOT the public anon key!)
# Important: This has unrestricted database access - keep secure
SUPABASE_SERVICE_ROLE_KEY=[REQUIRED - Get from Supabase Project Settings]

# ============================================
# ADMIN AUTHENTICATION [REQUIRED]
# ============================================
# Generate via: node -e "require('bcryptjs').hash('YOUR_SECURE_PASSCODE', 10).then(h => console.log(h))"
# Store the output hash below

INVENTORY_ADMIN_PASSWORD_HASH=[REQUIRED - Bcryptjs hash of your admin passcode]

# ============================================
# SESSION MANAGEMENT [REQUIRED]
# ============================================
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This signs session cookies - use a unique random value per environment

SESSION_SECRET=[REQUIRED - 64-char hex string from command above]

# ============================================
# Optional: Rate Limiting Configuration
# ============================================
# (Defaults shown below - only set if customizing)

# Admin login rate limiting
# ADMIN_LOGIN_WINDOW_MS=600000        # 10 minutes
# ADMIN_LOGIN_MAX_REQUESTS=8          # max 8 attempts per window

# Payment intent rate limiting
# PAYMENT_INTENT_WINDOW_MS=60000      # 60 seconds
# PAYMENT_INTENT_MAX_REQUESTS=20      # max 20 requests per window

# ============================================
# ============================================
# SETUP INSTRUCTIONS
# ============================================
# ============================================

# 1. GENERATE SECRETS
# ==================
# 
# Generate Session Secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   → Copy output to SESSION_SECRET above
#
# Generate Admin Password Hash:
#   node -e "require('bcryptjs').hash('YOUR_SECURE_PASSCODE_HERE', 10).then(h => console.log(h))"
#   → Replace YOUR_SECURE_PASSCODE_HERE with your actual admin passcode
#   → Copy output to INVENTORY_ADMIN_PASSWORD_HASH above
#
# 2. GET EXTERNAL SECRETS
# =======================
#
# Stripe API Keys:
#   a) Go to https://dashboard.stripe.com/apikeys (must be logged in)
#   b) Copy Secret key (sk_live_...) → STRIPE_SECRET_KEY
#   c) Copy Publishable key (pk_live_...) → VITE_STRIPE_PUBLIC_KEY
#   d) Go to https://dashboard.stripe.com/webhooks
#   e) Click "Add endpoint"
#   f) URL: https://[YOUR_DOMAIN].com/api/stripe/webhook
#   g) Select events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
#   h) Copy Signing secret (whsec_...) → STRIPE_WEBHOOK_SECRET
#
# Supabase Credentials:
#   a) Go to https://app.supabase.com/projects
#   b) Select your project
#   c) Go to Settings → API
#   d) Copy Project URL → SUPABASE_URL
#   e) Copy Service Role Secret (NOT anon key) → SUPABASE_SERVICE_ROLE_KEY
#   f) IMPORTANT: Service Role Key has unrestricted access - treat like a password
#
# 3. VERIFY BEFORE DEPLOYING
# ===========================
#
# Check that ALL [REQUIRED] values are filled in:
#   grep "\[REQUIRED" .env.production
#
# Should return 0 lines if all values filled in.
#
# Test database connection:
#   npm run test:db
#
# Test payment integration:
#   npm run test:stripe
#
# 4. DEPLOY
# =========
#
# npm run deploy:production
#

# ============================================
# SECURITY NOTES
# ============================================
#
# - NEVER commit .env or .env.production to git
# - NEVER log STRIPE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
# - NEVER share this file via email - use secure secret manager
# - Rotate SESSION_SECRET and INVENTORY_ADMIN_PASSWORD_HASH quarterly
# - If any key is exposed, regenerate immediately:
#   * Stripe: Revoke key in dashboard, generate new key
#   * Supabase: Rotate Service Role Key in project settings
#   * Session/Admin: Update .env and restart application
#
# Recommended secure storage:
# - AWS Secrets Manager
# - GitHub Secrets (for CI/CD)
# - 1Password / LastPass
# - HashiCorp Vault
#
